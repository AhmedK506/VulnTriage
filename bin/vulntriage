#!/usr/bin/env bash
# Convenience launcher for the VulnTriage CLI.
#
# Install (Kali / Debian):
#   sudo ln -s "$(pwd)/bin/vulntriage" /usr/local/bin/vulntriage
# Then from anywhere:
#   vulntriage scan results.xml -s zap --poc
#
# Honours an existing virtualenv if VULNTRIAGE_PYTHON is set, else uses python3.
set -e
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="${VULNTRIAGE_PYTHON:-python3}"
exec "$PY" "$ROOT/backend/cli.py" "$@"
